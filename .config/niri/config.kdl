prefer-no-csd


input {
    touchpad {
        tap
        natural-scroll
    }
}


cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 35
}


environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_QPA_PLATFORM "wayland;xcb"

    LANG "en_IN.UTF-8"
    LC_ALL "en_IN.UTF-8"
    LC_CTYPE "en_IN.UTF-8"
}


layout {

    default-column-width { proportion 1.0; }
    center-focused-column "on-overflow"

    gaps 0

    focus-ring {
        off
    }

    shadow {
        off
    }

}


output "eDP-1" {

    mode "1920x1080@144"
    variable-refresh-rate
    focus-at-startup

}


spawn-sh-at-startup "~/scripts/autostart.sh" // Autostart commands had to be put into another script in order to use a mix of sequential and parallel execution (to avoid a race condition with the logging system), which niri's config doesn't allow.
spawn-at-startup "~/scripts/wifi_autologin.sh"

spawn-sh-at-startup "alsactl restore -f ~/.asound.state" // fixes mic issues
spawn-sh-at-startup "codium --list-extensions > ~/Projects/dotfiles/vscodium-extensions.txt" // Integrating my vscode extension list into my dotfiles.


hotkey-overlay {
    skip-at-startup
}


switch-events {
    lid-close { spawn "sh" "-c" "niri msg action focus-workspace 9 && swaylock --color 000000 --show-failed-attempts --clock --indicator"; }
}


gestures {
    hot-corners {
        off
    }
}


binds {

    Mod+Left { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Down { focus-workspace-down; }
    Mod+Up { focus-workspace-up; }

    Mod+K repeat=false { close-window; }

    Alt+Space { spawn-sh "rofi -show drun -theme $HOME/.config/rofi/launcher.rasi || pkill rofi"; } // The first command throws an error if rofi is already running, so this keybind basically functions as a toggle for rofi.

    // If a keybind is pressed without shift, navigate to an already-running instance of the corresponding program. Otherwise, open a new instance. If shift is also pressed, then create a new instance of that program regardless of whether it is already running or not.
    Mod+C repeat=false { spawn-sh "~/scripts/app_opener.sh codium codium"; }
    Mod+Shift+C repeat=false { spawn "codium"; }
    Mod+Z repeat=false { spawn-sh "~/scripts/app_opener.sh zen zen-browser"; }
    Mod+Shift+Z repeat=false { spawn "zen-browser"; }
    Mod+F repeat=false { spawn-sh "~/scripts/app_opener.sh thunar thunar"; }
    Mod+Shift+F repeat=false { spawn "thunar"; }
    Mod+T repeat=false { spawn-sh "~/scripts/app_opener.sh kitty kitty"; }
    Mod+Shift+T repeat=false { spawn "kitty"; }

    Mod+L repeat=false { spawn "~/scripts/wifi_autologin.sh"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp allow-when-locked=true cooldown-ms=500 { spawn "brightnessctl" "--class=backlight" "set" "+3%"; }
    XF86MonBrightnessDown allow-when-locked=true cooldown-ms=500 { spawn "brightnessctl" "--class=backlight" "set" "3%-"; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Left { move-column-left; }

    Mod+Shift+S repeat=false { spawn "~/scripts/screenshot_capturer.sh"; }

    Mod+Ctrl+Alt+Delete allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { spawn "wlogout"; }

    Mod+Escape repeat=false { spawn-sh "niri msg action focus-workspace 9 && swaylock --color 000000 --show-failed-attempts --clock --indicator"; }

    Mod+Backspace repeat=false { spawn-sh "swaync-client --close-latest"; }

}
