configuration {
    show-icons:                 true;
	drun-display-format:        "{name}";
	window-format:              "{w} · {c} · {t}";
}

@import "~/.config/rofi/colours.rasi"

* {
    font: "JetBrains Mono Nerd Font 10";
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       800px;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               10px;
    border-color:                var(foreground);
    cursor:                      "default";
    background-color:            var(background);
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     20px;
    border:                      0px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px 0px 10px 0px;
    padding:                     5px 10px;
    border:                      0px solid;
    background-color:            var(background-alt);
    text-color:                  var(foreground);
    children:                    [ "textbox-prompt-colon", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}
textbox-prompt-colon {
    enabled:                     true;
    padding:                     5px 0px;
    expand:                      false;
    str:                         "";
    background-color:            inherit;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    padding:                     5px 0px;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
}


listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     5px;
    margin:                      0px;
    padding:                     10px;
    border-radius:               10px;
    border:                      2px;
    border-color:                var(foreground);
    background-color:            transparent;
    text-color:                  var(foreground);
    cursor:                      "default";
}
scrollbar {
    handle-width:                5px;
    handle-color:                var(selected);
    border-radius:               10px;
    background-color:            var(background-alt);
}


element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     6px;
    border:                      0px solid;
    border-radius:               6px;
    background-color:            transparent;
    text-color:                  var(foreground);
    cursor:                      pointer;
}
element normal.normal {
    background-color:            var(background);
    text-color:                  var(foreground);
}
element normal.urgent {
    background-color:            var(urgent);
    text-color:                  var(background);
}
element normal.active {
    background-color:            var(active);
    text-color:                  var(background);
}
element selected.normal {
    background-color:            var(selected);
    text-color:                  var(background);
}
element selected.urgent {
    background-color:            var(active);
    text-color:                  var(background);
}
element selected.active {
    background-color:            var(urgent);
    text-color:                  var(background);
}
element alternate.normal {
    background-color:            var(background);
    text-color:                  var(foreground);
}
element alternate.urgent {
    background-color:            var(urgent);
    text-color:                  var(background);
}
element alternate.active {
    background-color:            var(active);
    text-color:                  var(background);
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}


message {
    enabled:                     true;
    margin:                      0px 0px 10px 0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                var(selected);
    background-color:            transparent;
    text-color:                  var(foreground);
}


textbox {
    padding:                     10px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                var(selected);
    background-color:            var(background-alt);
    text-color:                  var(foreground);
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
    placeholder-color:           var(foreground);
    blink:                       true;
    markup:                      true;
}


error-message {
    padding:                     10px;
    border:                      2px solid;
    border-radius:               10px;
    border-color:                var(selected);
    background-color:            var(background);
    text-color:                  var(foreground);
}
