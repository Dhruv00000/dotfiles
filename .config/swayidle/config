timeout 200 'brightnessctl -s set $(($(brightnessctl get) * 3 / 5))' resume 'brightnessctl -r'
timeout 250 'pgrep -x swaylock || notify-send "Screen will be locked due to inactivity"'
timeout 300 'swaylock --color 000000 --show-failed-attempts --grace 3 --clock --indicator' resume '~/scripts/wifi_autologin.sh'
