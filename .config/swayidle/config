timeout 200 'brightnessctl --save set $(($(brightnessctl get) * 3 / 5))' resume 'brightnessctl --restore'
timeout 250 'pgrep --exact swaylock || notify-send "Screen will be locked due to inactivity" --icon /usr/share/icons/breeze-dark/actions/16/lock.svg' --app-name "swayidle"
timeout 300 'pgrep --exact swaylock || ~/scripts/screen_locker.sh --grace 3'