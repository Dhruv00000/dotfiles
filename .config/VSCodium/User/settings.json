{
    "explorer.confirmDelete": false,
    "editor.fontFamily": "FiraCode Nerd Font Mono",
    "editor.fontSize": 18,
    "workbench.sideBar.location": "right",
    "editor.mouseWheelZoom": true,
    "workbench.sideBar.experimental.fontSize": 16,
    "workbench.iconTheme": "catppuccin-mocha",
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.diagnosticMode": "workspace",
    "ruff.lint.select": [
        "F",
        "B",
        "I"
    ],
    "ruff.lint.ignore": [
    "E",
    "W"
    ],
    "workbench.colorTheme": "Nordavind",
    "files.autoSave": "afterDelay",
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "workbench.editorAssociations": {
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "*.pdf": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "editor.codeLensFontFamily": "FiraCode Nerd Font Mono",
    "editor.inlayHints.fontFamily": "FiraCode Nerd Font Mono",
    "terminal.integrated.fontFamily": "FiraCode Nerd Font",
    "notebook.markup.fontFamily": "FiraCode Nerd Font Mono",
    "notebook.output.fontFamily": "FiraCode Nerd Font Mono",
    "errorLens.fontFamily": "FiraCode Nerd Font Mono",
    "terminal.integrated.fontLigatures.enabled": true,
    "qt-core.additionalQtPaths": [
        {
            "name": "Qt-5.15.19-linux-g++-x86_64_from_PATH",
            "path": "/usr/bin/qmake"
        }
    ],
    "qt-core.showWelcomePageOnActivation": false
}